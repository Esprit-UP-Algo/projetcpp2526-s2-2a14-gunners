       <property name="styleSheet">
        <string notr="true">background-color: rgb(0, 36, 168);
border: #A8D3F0;
/* Style pour tous les GroupBox */
QGroupBox {
    border: 2px solid #2c3e50; /* Couleur de la bordure */
    border-radius: 15px;      /* Même arrondi que les boutons */
    margin-top: 20px;         /* Espace pour le titre en haut */
    font-weight: bold;
    color: #2c3e50;
}

/* Style spécifique pour le titre du GroupBox */
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center; /* Place le titre en haut au centre */
    padding: 0 10px;
}</string>
