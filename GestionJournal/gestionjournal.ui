  <property name="styleSheet">
   <string notr="true">QPushButton {
    /* La couleur de fond (bleu pro) */
    background-color: #2c3e50; 
    
    /* La couleur du texte */
    color: white;
    
    /* L'ARRONDI : plus le chiffre est grand, plus c'est rond */
    border-radius: 15px;
    
    /* Une bordure fine pour définir la forme */
    border: 1px solid #34495e;
    
    /* Espacement interne pour que le texte ne touche pas les bords */
    padding: 5px 15px;
}

/* Effet au survol de la souris */
QPushButton:hover {
    background-color: #34495e;
}
</string>
