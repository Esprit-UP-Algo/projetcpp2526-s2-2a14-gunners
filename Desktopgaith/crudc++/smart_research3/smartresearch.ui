    border-radius: 15px;      /* MÃªme arrondi que les boutons */
    margin-top: 20px;         /* Espace pour le titre en haut */
    font-weight: bold;
    color: #2c3e50;
}
/* Style spÃ©cifique pour le titre du GroupBox */
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center; /* Place le titre en haut au centre */
    padding: 0 10px;
}</string>
