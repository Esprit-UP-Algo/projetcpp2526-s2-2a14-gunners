	padding: 8px;
	background-color: white;
	color: #333;
	font-size: 14px;
}

QLineEdit:focus {
	border: 2px solid #0078D7;
}

QPushButton#btnLogin, QPushButton#btnSignUp {
	background-color: transparent;
	border: 2px solid #0078D7;
	border-radius: 20px;
	color: #0078D7;
	font-size: 16px;
	padding: 10px 40px;
	font-weight: bold;
}

QPushButton#btnLogin:hover, QPushButton#btnSignUp:hover {
	background-color: #0078D7;
	color: white;
}

QPushButton#btnLogin:pressed, QPushButton#btnSignUp:pressed {
	background-color: #005a9e;
	border-color: #005a9e;
	color: white;
}

QLabel {
	color: #333;
    font-size: 14px;
}
